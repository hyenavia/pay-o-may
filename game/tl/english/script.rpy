# game/script.rpy:600
translate english start_2aad442a:

    # centered "{size=48}{b}PAY O' MAY{/b}{/size}\n{size=26}Gim edukasi kesadaran finansial untuk mahasiswa perantauan{/size}"
    centered "{size=48}{b}PAY O' MAY{/b}{/size}\n{size=26}Financial awareness visual novel game for college students{/size}"

# game/script.rpy:601
translate english start_6433aa44:

    # centered "Cerita ini fiktif, tetapi dilema keuangannya nyata.\nSebelum mulai, kamu akan diminta mengisi {b}Pre-Test{/b}."
    centered "This story is fictional, but the financial dilemmas are real.\nBefore starting, you will be prompted to take a {b}Pre-Test{/b}."

# game/script.rpy:639
translate english nama_pemain_ca6d5acf:

    # "Awal bulan. Kamu baru enam bulan merantau ke kota ini untuk kuliah."
    "Start of the month. You've only been living away from home for six months to attend college in this city."

# game/script.rpy:643
translate english nama_pemain_2c7ec87a:

    # "HP-mu bergetar. Notifikasi m-banking: uang saku bulanan {b}Rp 2.000.000{/b} masuk."
    "Your phone vibrates. A mobile banking notification pops up: monthly allowance of {b}Rp 2,000,000{/b} received."

# game/script.rpy:650
translate english nama_pemain_7624ac75:

    # mama "Halo Nak, uang saku bulan ini sudah Mama kirim ya. Uang kos sudah Mama bayar langsung ke Ibu Kos."
    mama "Hi sweetie, I just sent your allowance for this month. I've already paid your dorm rent directly to the landlady."

# game/script.rpy:651
translate english nama_pemain_6d1e2faa:

    # mama "Uang itu untuk makan, transport, kuota, semuanya, sampai akhir bulan. Diatur baik-baik ya."
    mama "That money is for food, transportation, data, everything until month's end. Please manage it carefully."

# game/script.rpy:652
translate english nama_pemain_9ac18bd0:

    # p "Siap, Ma. Aku bisa atur kok."
    p "Got it, Mom. I can manage it well."

# game/script.rpy:653
translate english nama_pemain_7b63e1b3:

    # mama "Mama percaya. Jangan sampai kehabisan di tanggal tua ya."
    mama "I trust you. Just make sure you don't run out before the month is over."

# game/script.rpy:659
translate english nama_pemain_1b0c8866:

    # "Dua juta rupiah untuk sebulan. Rasanya banyak sekali. Tapi benarkah begitu?"
    "Two million rupiah for a month. It feels like a lot. But is it really?"

# game/script.rpy:670
translate english nama_pemain_d124aa04:

    # "Kamu memindahkan Rp 300.000 ke tabungan terpisah dan memberinya nama 'Dana Darurat - Jangan Disentuh'."
    "You transfer Rp 300,000 to a separate savings pot and name it 'Emergency Fund - Do Not Touch'."

# game/script.rpy:671
translate english nama_pemain_d4ab5709:

    # tip "Pay yourself first: sisihkan dana darurat di awal bulan, bukan dari sisa di akhir bulan. Sisa uang biasanya tidak pernah ada."
    tip "Pay yourself first: set aside emergency funds at the start of the month, not from whatever is left over. Leftovers rarely exist."

# game/script.rpy:677
translate english nama_pemain_fe135cc2:

    # "Semua uang menumpuk di satu rekening. Aman? Mungkin. Terarah? Belum."
    "All your money sits in one account. Safe? Maybe. Well-structured? Not yet."

# game/script.rpy:678
translate english nama_pemain_15c6e36f:

    # tip "Tanpa pos-pos yang jelas, sulit melihat ke mana uang pergi. Uang yang tidak punya tugas cenderung habis tanpa terasa."
    tip "Without clear budget buckets, it's hard to see where money goes. Money without an assigned task tends to vanish unnoticed."

# game/script.rpy:685
translate english nama_pemain_9fa246b8:

    # "Sepatu baru kinclong. Saldo menyusut seketika."
    "Brand new shiny sneakers. But your balance instantly dwindles."

# game/script.rpy:686
translate english nama_pemain_ffb17396:

    # tip "Membeli keinginan sebelum memenuhi kebutuhan adalah pola yang paling sering membuat mahasiswa kehabisan uang di pertengahan bulan."
    tip "Buying wants before meeting needs is the most common pitfall that leaves students broke midway through the month."

# game/script.rpy:707
translate english nama_pemain_ec98ecb8:

    # dimas "[nama]! Uang saku udah masuk, kan? Ayo nongkrong di kafe baru itu, lagi viral banget!"
    dimas "[nama]! Your allowance came in, right? Come hang out at that new cafe, it's going totally viral!"

# game/script.rpy:708
translate english nama_pemain_747a712d:

    # dimas "Anak-anak kelas udah pada ke sana. Masa cuma kamu yang nggak ikut?"
    dimas "Everyone from class is heading there. You're not gonna be the only one missing out, are you?"

# game/script.rpy:709
translate english nama_pemain_77b85d47:

    # "Perutmu mulas sedikit. Itu rasanya FOMO: takut ketinggalan, takut dianggap kurang gaul."
    "Your stomach tightens a bit. That's FOMO: fear of missing out, fear of being seen as uncool."

# game/script.rpy:721
translate english nama_pemain_7b3d4acf:

    # "Makanan, minuman, dessert, patungan live music. Struknya: {b}Rp 250.000{/b} untuk satu malam."
    "Food, drinks, dessert, and splitting the live music fee. The receipt totals: {b}Rp 250,000{/b} for one single night."

# game/script.rpy:722
translate english nama_pemain_26925a95:

    # tip "Pengeluaran 'sekali-sekali' yang besar bisa menghabiskan seperempat uang saku bulananmu dalam satu malam."
    tip "A single hefty splurge can easily wipe out a quarter of your entire monthly allowance in just one night."

# game/script.rpy:732
translate english nama_pemain_cb630dae:

    # "Kamu tetap ikut seru-seruan, dompet tetap aman. Total: Rp 40.000."
    "You still join the fun while keeping your wallet safe. Total spent: Rp 40,000."

# game/script.rpy:733
translate english nama_pemain_f40f6fab:

    # tip "Hemat bukan berarti anti sosial. Kamu bisa tetap hadir dengan batas pengeluaran yang sudah kamu tentukan sendiri."
    tip "Frugality isn't anti-social. You can show up and socialize within a spending limit you set beforehand."

# game/script.rpy:740
translate english nama_pemain_2fdab7ef:

    # dimas "Yah... oke deh, tapi minggu depan beneran ya!"
    dimas "Aww... okay then, but for real next week, promise!"

# game/script.rpy:742
translate english nama_pemain_fba6139a:

    # "Dompet aman, tapi kamu agak terlewat dari obrolan seru malam itu."
    "Your wallet is intact, though you missed out on some of tonight's lively chatter."

# game/script.rpy:743
translate english nama_pemain_b37f9f95:

    # tip "Menolak itu sah. Tapi cari cara tetap terhubung dengan teman, karena menarik diri sepenuhnya sulit dipertahankan."
    tip "Saying no is totally valid. Just find other ways to stay connected, as complete isolation is hard to sustain."

# game/script.rpy:753
translate english nama_pemain_f5cb6e17:

    # "Malamnya, di kamar kos, HP-mu bergetar lagi."
    "Later that night in your dorm room, your phone buzzes again."

# game/script.rpy:756
translate english nama_pemain_faf1348d:

    # "{b}FLASH SALE!{/b} Headset Bluetooth Rp 399.000. Bayar Nanti dengan PayLater, bunga 0 persen bulan pertama!"
    "{b}FLASH SALE!{/b} Bluetooth Headset Rp 399,000. Buy Now Pay Later, 0 percent interest for the first month!"

# game/script.rpy:757
translate english nama_pemain_fef9807f:

    # "Headset lamamu sebenarnya masih berfungsi. Hanya saja baterainya agak cepat habis."
    "Your old headset still works fine. The battery just drains a bit quicker than before."

# game/script.rpy:768
translate english nama_pemain_f090b9e5:

    # "Klik. Selesai. Kamu merasa belum mengeluarkan uang sepeser pun. Padahal tagihannya sudah menunggu di ujung bulan."
    "Click. Done. It feels like you haven't spent a single penny. Yet the bill is already waiting at month's end."

# game/script.rpy:769
translate english nama_pemain_cf40a1c5:

    # tip "PayLater itu utang, bukan uang tambahan. Rasa 'belum bayar' membuat kita lebih mudah belanja berlebihan."
    tip "PayLater is debt, not extra cash. The sensation of 'not paying yet' tricks our minds into overspending."

# game/script.rpy:778
translate english nama_pemain_6adddcac:

    # "Headset baru datang dua hari kemudian. Uang jajanmu menipis hampir seperlima."
    "The new headset arrives two days later. Your daily allowance is slashed by nearly a fifth."

# game/script.rpy:779
translate english nama_pemain_a92e499a:

    # tip "Membayar tunai memang lebih sehat daripada berutang. Tapi pertanyaan utamanya tetap: apakah ini kebutuhan atau keinginan?"
    tip "Paying cash is healthier than taking on debt. But the fundamental question remains: is it a need, or a want?"

# game/script.rpy:787
translate english nama_pemain_8a466d59:

    # "Tiga hari kemudian, kamu sadar headset lamamu masih oke. Keranjang dikosongkan tanpa penyesalan."
    "Three days later, you realize your old headset is doing just fine. You empty the cart with zero regrets."

# game/script.rpy:788
translate english nama_pemain_9e57e0e9:

    # tip "Aturan tunggu 24 jam sampai 3 hari efektif mengurangi belanja impulsif. Keinginan yang sungguhan akan tetap ada setelah ditunggu."
    tip "The 24-hour to 3-day waiting rule is remarkably effective against impulse buys. Genuine desires will still hold true after the wait."

# game/script.rpy:800
translate english nama_pemain_70d04955:

    # "Minggu kedua dimulai."
    "Week two begins."

# game/script.rpy:804
translate english nama_pemain_c2f1f853:

    # "Grup kelas masih ramai dengan foto kafe viral itu. Kamu membuka struk Rp 250.000 dan menggeleng pelan."
    "The class group chat is still buzzing with photos from that viral cafe. You glance at the Rp 250,000 receipt and shake your head gently."

# game/script.rpy:806
translate english nama_pemain_9d86d273:

    # "Tumbler dari kos jadi bahan candaan di grup kelas. Tapi dompetmu tertawa paling terakhir."
    "Your dorm tumbler became a friendly joke in the chat. But your wallet has the last laugh."

# game/script.rpy:808
translate english nama_pemain_2280a9f6:

    # "Kamu melewatkan malam kafe itu. Di grup kelas, foto-foto bermunculan dan kamu menatapnya agak lama."
    "You skipped that cafe night. As photos pop up in the class chat, you stare at them for a quiet moment."

# game/script.rpy:812
translate english nama_pemain_34f524af:

    # "Setiap kali membuka aplikasi bank, kamu teringat tagihan PayLater Rp 399.000 yang menunggu di ujung bulan."
    "Every time you check your banking app, you're reminded of the Rp 399,000 PayLater bill looming at month's end."

# game/script.rpy:814
translate english nama_pemain_9beac0b8:

    # "Headset baru nyaman di telinga, tapi setiap melihat saldo kamu menghitung ulang uang makan minggu ini."
    "The new headset sounds great, but seeing your balance makes you recalculate this week's meal budget."

# game/script.rpy:816
translate english nama_pemain_e21b8703:

    # "Keranjang belanja yang kosong itu membuatmu merasa ringan. Saldo masih utuh."
    "That emptied shopping cart brings a wave of relief. Your balance remains untouched."

# game/script.rpy:818
translate english nama_pemain_93a40bec:

    # "Kamu mulai sadar bahwa urusan makan adalah pos pengeluaran terbesar yang paling sering terlupa."
    "You begin to realize that food is the largest and most easily overlooked expense category."

# game/script.rpy:827
translate english nama_pemain_f54040d4:

    # "Ongkir, biaya layanan, dan harga yang naik di aplikasi. Terkumpul tambahan {b}Rp 200.000{/b} minggu ini."
    "Delivery fees, service charges, and marked-up app prices. An extra {b}Rp 200,000{/b} accumulated this week."

# game/script.rpy:828
translate english nama_pemain_e567406c:

    # tip "Biaya kecil seperti ongkir dan biaya layanan terasa remeh satu per satu, tetapi menumpuk menjadi pengeluaran besar."
    tip "Small fees like delivery and service charges seem trivial individually, but they quickly pile up into huge expenses."

# game/script.rpy:834
translate english nama_pemain_89f58167:

    # "Kamu masak dua kali, sisanya pesan. Tambahan pengeluaran: Rp 80.000."
    "You cooked twice and ordered takeout for the rest. Additional expenses: Rp 80,000."

# game/script.rpy:835
translate english nama_pemain_2ac7aa27:

    # tip "Kompromi yang masuk akal, dan lebih baik daripada tanpa rencana sama sekali."
    tip "A sensible compromise, and far better than having no plan at all."

# game/script.rpy:841
translate english nama_pemain_3fa44659:

    # "Kamu masak nasi, telur, dan sayur untuk beberapa hari. Tidak ada pengeluaran tambahan, dan perut tetap kenyang."
    "You cooked rice, eggs, and veggies for several days. Zero extra spending, and your belly stays full."

# game/script.rpy:842
translate english nama_pemain_744dde4b:

    # tip "Makan adalah kebutuhan, tetapi cara memenuhinya bisa dipilih. Memasak sendiri biasanya jauh lebih murah dari memesan."
    tip "Food is a basic need, but how you fulfill it is a choice. Cooking for yourself is usually far cheaper than ordering takeout."

# game/script.rpy:853
translate english nama_pemain_de9421c2:

    # sinta "Hei [nama], kok mukamu bingung lihat saldo? Aku juga dulu begitu."
    sinta "Hey [nama], why the confused face staring at your balance? I used to be like that too."

# game/script.rpy:854
translate english nama_pemain_d8558e5f:

    # sinta "Sejak aku mencatat semua pengeluaran, aku jadi tahu uangku bocor ke mana."
    sinta "Ever since I started tracking every expense, I know exactly where my money was leaking."

# game/script.rpy:855
translate english nama_pemain_977b719e:

    # sinta "Coba aturan 50, 30, 20 versi mahasiswa: 50 persen kebutuhan, 30 persen keinginan, 20 persen tabungan. Gampang kok."
    sinta "Try the student version of the 50/30/20 rule: 50 percent needs, 30 percent wants, 20 percent savings. It's really simple."

# game/script.rpy:866
translate english nama_pemain_2dadbf2c:

    # sinta "Nah gitu! Nanti kamu bakal kaget lihat kebocoran kecilnya."
    sinta "That's the spirit! You'll be surprised to see where those little leaks were going."

# game/script.rpy:867
translate english nama_pemain_87c651a8:

    # "Mulai sekarang, kamu bisa melihat jumlah keinginan yang sudah kamu penuhi di papan status."
    "From now on, you can track the number of wants you've indulged in on the status HUD."

# game/script.rpy:868
translate english nama_pemain_83ee4bbd:

    # tip "Mencatat pengeluaran membuat kebocoran kecil terlihat. Kopi Rp 25.000 dikali 20 hari sama dengan Rp 500.000 per bulan."
    tip "Tracking expenses brings hidden leaks into the light. A Rp 25,000 coffee times 20 days equals Rp 500,000 every month."

# game/script.rpy:874
translate english nama_pemain_5503c2dc:

    # sinta "Ya udah, tapi kalau butuh bantuan bilang ya."
    sinta "Alright, but just let me know whenever you need help."

# game/script.rpy:875
translate english nama_pemain_76b1e052:

    # "Kamu kembali menjalani minggu tanpa catatan. Saldo cuma kamu cek kalau ingat."
    "You go through the week without keeping logs. You only check your balance whenever you happen to remember."

# game/script.rpy:876
translate english nama_pemain_e8fabfd3:

    # tip "Tanpa pencatatan, kita hanya menebak. Kebanyakan orang menebak pengeluarannya jauh lebih kecil dari kenyataan."
    tip "Without tracking, we are merely guessing. Most people guess their expenses are far lower than reality."

# game/script.rpy:885
translate english nama_pemain_c2c02230:

    # "Malam hari. Serial yang ramai dibicarakan satu angkatan hanya tayang di layanan streaming berbayar."
    "Late night. The hit series everyone in your class is talking about is only streaming on a paid subscription platform."

# game/script.rpy:888
translate english nama_pemain_b31633a5:

    # "Teman-temanmu mulai saling spoiler di grup. Kamu mulai tergoda."
    "Your friends start dropping spoilers in the group chat. Temptation starts creeping in."

# game/script.rpy:899
translate english nama_pemain_fdaed4cd:

    # "Terasa hemat, padahal kamu baru saja mengeluarkan Rp 300.000 sekaligus di awal bulan dengan uang saku terbatas."
    "It feels like a discount, but you just dropped Rp 300,000 all at once early in the month on a limited allowance."

# game/script.rpy:900
translate english nama_pemain_65690e38:

    # tip "Diskon tahunan baru hemat jika kamu benar-benar memakainya. Ia juga mengunci uang yang mungkin kamu butuhkan bulan ini."
    tip "An annual discount is only a bargain if you actually use it. It also locks up cash you might urgently need this month."

# game/script.rpy:909
translate english nama_pemain_60965498:

    # "Kamu memasang pengingat di kalender HP untuk membatalkan langganan sebelum bulan berikutnya."
    "You set a reminder on your phone's calendar to cancel the subscription before next month begins."

# game/script.rpy:910
translate english nama_pemain_5aca2e4d:

    # tip "Langganan bulanan fleksibel, tapi mudah terlupa dibatalkan. Pasang pengingat agar tidak menjadi pengeluaran diam-diam."
    tip "Monthly subscriptions are flexible, but easily forgotten. Always set a reminder so they don't become silent leaks."

# game/script.rpy:924
translate english nama_pemain_85c89a3e:

    # dimas "Nah, camilan datang! Nobar di kos emang paling mantap, serunya dapet, dompet tetep aman!"
    dimas "Snacks are here! Watching together in the dorm is unbeatable—all the fun, and our wallets stay safe!"

# game/script.rpy:928
translate english nama_pemain_f57e84fe:

    # "Nobar ternyata jauh lebih seru daripada nonton sendirian di kamar, dan kamu hanya mengeluarkan Rp 15.000 untuk camilan."
    "Watching together turns out way more fun than binging alone in your room, and you only spent Rp 15,000 on snacks."

# game/script.rpy:929
translate english nama_pemain_adbf78bf:

    # tip "Keinginan bisa dipenuhi dengan cara yang lebih murah. Sering kali cara itu sekaligus lebih menyenangkan."
    tip "Wants can often be satisfied in cheaper ways. Quite often, those alternatives end up being much more enjoyable."

# game/script.rpy:939
translate english nama_pemain_5f15b64a:

    # "Minggu ketiga. Kamis malam, jam sepuluh. Tugas besar harus dikumpulkan besok pagi."
    "Week three. Thursday night, ten o'clock. A major class assignment is due first thing tomorrow morning."

# game/script.rpy:940
translate english nama_pemain_340f7491:

    # "Tiba-tiba laptopmu mati. Charger-nya putus tepat di sambungan kabel. Baterai tinggal sedikit."
    "Suddenly your laptop shuts down. The charger wire snapped right at the cord junction. The battery is almost dead."

# game/script.rpy:941
translate english nama_pemain_e5682e92:

    # "Charger original di toko resmi harganya {b}Rp 275.000{/b}. Toko buka besok pagi dan kamu harus memutuskan sumber dananya sekarang."
    "An original charger at the official store costs {b}Rp 275,000{/b}. The shop opens tomorrow morning, and you must decide where the money comes from right now."

# game/script.rpy:950
translate english nama_pemain_f4c679e5:

    # "Tugas selesai tepat waktu, dan uang makanmu tidak terganggu. Dana darurat menjalankan tugasnya."
    "The assignment gets submitted on time, and your meal money stays untouched. Your emergency fund did its job."

# game/script.rpy:951
translate english nama_pemain_cc7253e9:

    # tip "Dana darurat ada agar kejadian tak terduga tidak berubah menjadi krisis. Idealnya mencakup beberapa minggu sampai beberapa bulan kebutuhan pokok."
    tip "Emergency funds exist so unexpected mishaps don't escalate into full crises. Ideally, aim to buffer several weeks or months of basic needs."

# game/script.rpy:957
translate english nama_pemain_6a58a395:

    # "Charger terbeli, tugas aman. Tapi uang makan minggu depan terpaksa diirit."
    "The charger is bought, the assignment is saved. But you'll have to skimp hard on next week's meals."

# game/script.rpy:958
translate english nama_pemain_ce975113:

    # tip "Tanpa dana darurat, kejadian tak terduga memotong uang kebutuhan sehari-hari."
    tip "Without an emergency fund, unexpected emergencies take a direct bite out of your everyday essentials."

# game/script.rpy:962
translate english nama_pemain_b9b38db0:

    # "Charger terbeli. Tagihannya masuk ke daftar yang akan jatuh tempo di akhir bulan."
    "The charger is bought. The charge gets tacked onto your bills due at the end of the month."

# game/script.rpy:963
translate english nama_pemain_f2542f1c:

    # tip "Menutup kebutuhan mendadak dengan utang konsumtif adalah awal dari lingkaran gali lubang tutup lubang."
    tip "Covering urgent needs with consumer debt is the first step into a vicious debt cycle."

# game/script.rpy:971
translate english nama_pemain_b865ffcf:

    # mama "Ya ampun, charger rusak? Mama transfer sekarang. Tapi lain kali sisihkan dana darurat sendiri ya, Nak."
    mama "Oh dear, your charger broke? Mom will transfer the money right away. But next time, please set aside your own emergency fund, sweetie."

# game/script.rpy:975
translate english nama_pemain_5cd13104:

    # "Masalah selesai, tapi ada rasa tidak enak karena harus merepotkan Mama."
    "Problem solved, but an uneasy guilt lingers from having to trouble Mom."

# game/script.rpy:976
translate english nama_pemain_dbda7a96:

    # tip "Meminta bantuan keluarga sah-sah saja untuk keadaan darurat sungguhan, tapi tujuan utamanya adalah mandiri secara finansial."
    tip "Asking family for help is completely acceptable in a genuine emergency, but the ultimate goal is achieving financial independence."

# game/script.rpy:985
translate english nama_pemain_6eb8c28e:

    # sinta "Sekarang udah tanggal 20-an. Biasanya di titik ini mulai kerasa tipisnya."
    sinta "It's past the 20th already. Usually this is where the pinch really starts to set in."

# game/script.rpy:986
translate english nama_pemain_a9f8537d:

    # sinta "Kalau masih ada sisa, sisihkan dulu ke dana darurat sebelum kamu habiskan."
    sinta "If you have anything left, tuck it away into your emergency fund before you spend it."

# game/script.rpy:989
translate english nama_pemain_9e5c9a36:

    # sinta "Oh ya, aku lihat bekalmu minggu lalu. Keren! Itu salah satu cara terbaik menghemat."
    sinta "By the way, I saw your meal prep last week. Awesome job! That's one of the best ways to save."

# game/script.rpy:991
translate english nama_pemain_308fb56e:

    # sinta "Aku sempat lihat riwayat pesan antarmu. Ongkir dan biaya layanannya lumayan bikin deg-degan, ya?"
    sinta "I caught a glimpse of your food delivery history. Those delivery fees and service charges can really make your heart skip a beat, huh?"

# game/script.rpy:994
translate english nama_pemain_e2f153dc:

    # sinta "Eh, kamu beneran ambil paket tahunan streaming itu? Lumayan nguras saldo awal bulan ya."
    sinta "Wait, did you really buy that annual streaming subscription? That's quite a dent in your early-month balance."

# game/script.rpy:996
translate english nama_pemain_3187c07a:

    # sinta "Seru ya nobar di kos kemarin. Kadang kumpul bareng jauh lebih asyik daripada bayar langganan mahal sendirian."
    sinta "That watch party in the dorm was so fun! Sometimes hanging out together is way better than paying for an expensive subscription alone."

# game/script.rpy:1000
translate english nama_pemain_900d8c07:

    # "Kamu membuka catatan pengeluaranmu. Sisa uang jajan saat ini: [t]."
    "You open your expense logs. Current remaining allowance: [t]."

# game/script.rpy:1002
translate english nama_pemain_8c26a46c:

    # "Sisa uangmu begitu tipis sampai menabung terasa mustahil."
    "Your remaining balance is so thin that saving feels virtually impossible."

# game/script.rpy:1014
translate english nama_pemain_9e8fcc90:

    # "Kamu memindahkan Rp 100.000. Sedikit demi sedikit, bantalan pengamanmu menebal."
    "You transfer Rp 100,000. Bit by bit, your safety cushion grows thicker."

# game/script.rpy:1015
translate english nama_pemain_73afe919:

    # tip "Menabung rutin dalam jumlah kecil lebih berhasil daripada menunggu punya uang lebih."
    tip "Consistently saving small amounts works far better than waiting until you have extra cash."

# game/script.rpy:1022
translate english nama_pemain_315f0772:

    # "Tidak banyak, tapi kamu memulai kebiasaannya."
    "It isn't a fortune, but you're establishing the habit."

# game/script.rpy:1023
translate english nama_pemain_0e8ef72b:

    # tip "Kebiasaan menabung lebih penting daripada jumlahnya. Naikkan nominalnya pelan-pelan."
    tip "The habit of saving matters more than the initial amount. Increase the sum gradually over time."

# game/script.rpy:1028
translate english nama_pemain_e3c80506:

    # "Kamu menyimpan sisanya di rekening yang sama. Tentu saja uang itu mudah tergoda untuk dipakai."
    "You leave the rest in your primary account. Unsurprisingly, that cash is easy to spend impulsively."

# game/script.rpy:1029
translate english nama_pemain_27991ec8:

    # tip "Uang yang bercampur dengan uang jajan jarang bertahan menjadi tabungan. Pisahkan rekening atau dompetnya."
    tip "Money co-mingled with your daily allowance rarely survives as savings. Keep separate accounts or wallets."

# game/script.rpy:1038
translate english nama_pemain_e0979365:

    # "Malam itu HP-mu bergetar. Pesan dari Axel."
    "Later that night, your phone buzzes. A message from Axel."

# game/script.rpy:1043
translate english nama_pemain_ba7ca38c:

    # "Kamu teringat malam di kafe viral itu. Struk Rp 250.000-mu ternyata punya kembaran di dompet Axel."
    "You recall that night at the viral cafe. Your Rp 250,000 receipt had a twin in Axel's wallet too."

# game/script.rpy:1045
translate english nama_pemain_6797eca8:

    # "Kamu teringat Axel memesan jauh lebih banyak dari yang kamu pesan di kafe waktu itu."
    "You remember Axel ordering far more extravagantly than you did at the cafe back then."

# game/script.rpy:1047
translate english nama_pemain_95fa13e5:

    # "Kamu teringat Axel yang kecewa saat kamu menolak ke kafe. Rupanya dia terus mengikuti ajakan lain tanpa batas."
    "You remember Axel looking dejected when you declined the cafe. Apparently he kept tagging along on other outings without limits."

# game/script.rpy:1057
translate english nama_pemain_c8368867:

    # "Kamu transfer tanpa banyak berpikir. 'Makasih banget, bro!' balasnya. Sisa uangmu ikut menipis drastis."
    "You transfer the money without second thought. 'Thanks a ton, bro!' he replies. Your own balance takes a sharp hit."

# game/script.rpy:1058
translate english nama_pemain_6bfe4027:

    # tip "Meminjamkan uang yang kamu butuhkan sendiri berisiko dua kali: uangmu tertahan, dan pertemanan bisa canggung jika terlambat dikembalikan."
    tip "Lending money you need yourself carries double risk: your cash gets locked, and friendships turn awkward if repayment is delayed."

# game/script.rpy:1066
translate english nama_pemain_aea2587e:

    # "Kamu mengetik balasan dan mentransfer seikhlasnya. 'Cuma segini yang bisa aku bantu,' tulismu. 'Cukup kok, makasih!' balas Axel."
    "You type a reply and transfer what you can spare. 'This is all I can help with,' you write. 'It's plenty, thanks!' Axel replies."

# game/script.rpy:1067
translate english nama_pemain_892b7f7b:

    # tip "Aturan sederhana: pinjamkan hanya jumlah yang siap kamu relakan jika tidak kembali."
    tip "A simple rule: only lend an amount you are truly prepared to write off if it isn't returned."

# game/script.rpy:1074
translate english nama_pemain_58922053:

    # "Kamu menjelaskan dengan jujur bahwa uangmu juga terbatas, lalu menawarkan bantuan lain: menyusun anggaran sisa bulan bersama. Balasan Axel agak lama, tapi akhirnya dia setuju."
    "You honestly explain that your funds are also tight, then offer alternative help: budgeting the rest of the month together. Axel takes a while to reply, but eventually agrees."

# game/script.rpy:1075
translate english nama_pemain_1baddc37:

    # tip "Menolak pinjaman bukan berarti tidak peduli. Membantu mencari solusi sering lebih berguna daripada memberi uang."
    tip "Refusing a loan doesn't mean you don't care. Helping brainstorm solutions is often far more constructive than handing out cash."

# game/script.rpy:1087
translate english nama_pemain_2ad193d1:

    # "Minggu terakhir. Sore itu, Mama menelepon."
    "The final week. That afternoon, Mom calls."

# game/script.rpy:1094
translate english nama_pemain_a3d40bd1:

    # mama "Halo Nak, sudah minggu terakhir ya. Bagaimana uang sakumu?"
    mama "Hi sweetie, it's the final week already. How is your allowance holding up?"

# game/script.rpy:1100
translate english nama_pemain_93195181:

    # p "Hmm... sebenarnya saldoku sudah minus, Ma."
    p "Um... honestly, my balance is already in the negative, Mom."

# game/script.rpy:1101
translate english nama_pemain_e0d1899e:

    # mama "Ya ampun. Tidak apa-apa, Nak. Yang penting kamu cerita. Nanti kita atur bareng ya."
    mama "Oh goodness. It's okay, dear. The important thing is you told me honestly. We'll figure it out together, okay?"

# game/script.rpy:1106
translate english nama_pemain_a8785a26:

    # p "Aman kok, Ma..."
    p "Everything's fine, Mom..."

# game/script.rpy:1107
translate english nama_pemain_eb2fdaf3:

    # mama "Suaramu tidak seyakin biasanya. Ada yang ingin kamu ceritakan?"
    mama "Your voice doesn't sound as confident as usual. Is there something you want to share with Mom?"

# game/script.rpy:1108
translate english nama_pemain_c2e5e0b6:

    # "Kamu menelan ludah. Ada tagihan PayLater yang belum kamu ceritakan."
    "You swallow hard. There's an outstanding PayLater bill you haven't mentioned."

# game/script.rpy:1113
translate english nama_pemain_cec7c304:

    # mama "Mama senang kamu mau cerita soal charger kemarin. Bulan depan, coba sisihkan dana darurat sendiri ya."
    mama "I'm glad you opened up about the charger situation earlier. Next month, try building your own emergency fund, okay?"

# game/script.rpy:1118
translate english nama_pemain_53f1c568:

    # mama "Wah, Mama dengar kamu punya dana darurat sendiri? Mama bangga sekali, Nak."
    mama "Wow, I hear you built your own emergency fund? Mom is so proud of you, sweetie."

# game/script.rpy:1123
translate english nama_pemain_a850e91d:

    # mama "Jangan lupa sisihkan sedikit untuk jaga-jaga ya, Nak."
    mama "Don't forget to set a little aside for a rainy day, alright dear?"

# game/script.rpy:1140
translate english nama_pemain_c67ec1bd:

    # dimas "Eh [nama], ini uang kemarin Rp 50.000 udah aku transfer balik. Makasih banget ya!"
    dimas "Hey [nama], I just transferred back the Rp 50,000 from before. Thanks a million!"

# game/script.rpy:1145
translate english nama_pemain_abd678ba:

    # dimas "Soal pinjaman kemarin, maaf ya, belum bisa aku ganti dulu. Uang saku bulananku ternyata udah mepet banget... Bulan depan pasti!"
    dimas "About the loan from before... I'm so sorry, I can't pay you back yet. My monthly allowance ran super tight... Next month for sure!"

# game/script.rpy:1147
translate english nama_pemain_03f0ac73:

    # "Kamu tersenyum kaku. Uang Rp 200.000 itu sekarang menggantung di antara kalian."
    "You offer a stiff smile. That Rp 200,000 now hangs uncomfortably between the two of you."

# game/script.rpy:1151
translate english nama_pemain_613d7906:

    # dimas "Kemarin aku sempat agak kesal waktu kamu tolak, sih. Tapi setelah kita susun pos anggaran bareng kemarin, kamu bener juga. Aku mulai coba catat pengeluaran sekarang."
    dimas "I was a bit bummed when you turned me down at first. But after we mapped out our budgets together, you were totally right. I'm starting to log my spending now too."

# game/script.rpy:1153
translate english nama_pemain_d8494948:

    # dimas "[nama], weekend ini kita ke Lembang! Sewa vila patungan, BBQ, foto-foto. Total {b}Rp 300.000{/b} all-in."
    dimas "[nama], this weekend we're hitting Lembang! Splitting a villa, BBQ, photo sessions. Total {b}Rp 300,000{/b} all-in."

# game/script.rpy:1154
translate english nama_pemain_f97ad5f3:

    # dimas "Ini momen terakhir sebelum UAS. Kalau nggak ikut, nyesel loh!"
    dimas "This is our last chance before finals! If you miss out, you'll totally regret it!"

# game/script.rpy:1158
translate english nama_pemain_6d5a61ba:

    # "Kamu membuka catatan pengeluaranmu. Sisa uang jajan: [t]. Sisa waktu hingga akhir bulan: beberapa hari."
    "You pull up your expense log. Remaining allowance: [t]. Days left until month's end: just a few."

# game/script.rpy:1160
translate english nama_pemain_4ec431ce:

    # "Kamu mencoba mengingat-ingat. Sisa uangmu berapa ya? Sepertinya masih cukup."
    "You try to do mental math. How much money do you have left? Seems like enough... probably."

# game/script.rpy:1170
translate english nama_pemain_cec7462c:

    # "Seru banget. Foto-fotonya bagus. Tapi saat pulang, saldo di aplikasi bank membuatmu menelan ludah."
    "It was a blast. The photos look amazing. But on the way home, checking your bank app makes you gulp in dread."

# game/script.rpy:1171
translate english nama_pemain_216fa7a8:

    # tip "FOMO sering hanya bertahan satu malam, sedangkan dampak ke dompet bertahan sampai akhir bulan."
    tip "FOMO thrills usually last one evening, while the wallet hangover lingers for the rest of the month."

# game/script.rpy:1179
translate english nama_pemain_5d96b635:

    # "Kamu tetap ikut seru-seruan dengan biaya lebih ringan."
    "You still join in on the fun, but on a much lighter budget."

# game/script.rpy:1180
translate english nama_pemain_1c4bdacb:

    # tip "Menawar versi yang lebih murah adalah kompromi cerdas antara keinginan dan kemampuan."
    tip "Choosing a budget-friendly compromise is a smart balance between desires and actual affordability."

# game/script.rpy:1187
translate english nama_pemain_ad35b8e4:

    # dimas "Hmm, ya sudah. Tapi janji ya lain kali!"
    dimas "Hmm, alright then. But promise you'll come next time!"

# game/script.rpy:1188
translate english nama_pemain_1118203b:

    # "Kamu menolak dengan sopan dan merasa tenang karena sudah tahu batasanmu."
    "You decline politely and feel at peace knowing your boundaries."

# game/script.rpy:1189
translate english nama_pemain_a44dc054:

    # tip "Mengatakan 'tidak' untuk keinginan hari ini adalah mengatakan 'ya' untuk ketenangan di akhir bulan."
    tip "Saying 'no' to impulsive wants today means saying 'yes' to peace of mind at month's end."

# game/script.rpy:1200
translate english nama_pemain_7eb0b74a:

    # "Notifikasi promo muncul tepat saat uangmu mulai tipis. Di kamar, sabunmu tinggal sedikit dan tisumu hampir habis."
    "A discount notification pops up right as funds run low. In your room, body soap is nearly empty and tissues are down to the last sheet."

# game/script.rpy:1211
translate english nama_pemain_f1d6e5b1:

    # "Barang datang bertumpuk di pojok kamar kos. Sebagian besar baru akan terpakai beberapa bulan lagi, sementara uang saku akhir bulanmu terkuras seketika."
    "Packages pile up in the corner of your dorm room. Most won't be opened for months, while your month-end cash is instantly wiped out."

# game/script.rpy:1212
translate english nama_pemain_f116f6bb:

    # tip "Diskon hanya menghemat jika barangnya memang kamu butuhkan sekarang. Barang yang menumpuk adalah uang yang tertidur."
    tip "Discounts only save money if you genuinely need the items now. Stockpiled clutter is dormant cash."

# game/script.rpy:1219
translate english nama_pemain_354bd638:

    # "Kamu membeli sabun dan tisu yang memang mendesak, lalu menyingkirkan barang promo lainnya dari keranjang belanja."
    "You purchase only the urgent soap and tissues, purging the remaining promotional items from your shopping cart."

# game/script.rpy:1220
translate english nama_pemain_76651bc2:

    # tip "Belanja dengan daftar kebutuhan membuat kamu mengendalikan promo, bukan sebaliknya."
    tip "Shopping with an essentials list ensures you control the promotions, not the other way around."

# game/script.rpy:1226
translate english nama_pemain_48d5e806:

    # "Kamu menutup aplikasi belanja dan menghela napas lega. Kamu menghemat uang, meski sabun dan tisumu harus diirit sampai bulan depan."
    "You close the shopping app and breathe a sigh of relief. You saved cash, even if soap and tissues must be rationed carefully until next month."

# game/script.rpy:1227
translate english nama_pemain_3589bf28:

    # tip "Menunda pembelian itu baik, tetapi pastikan kebutuhan dasar tetap terpenuhi agar tidak jadi masalah di kemudian hari."
    tip "Delaying purchases is wise, but ensure essential needs are fulfilled so they don't cause complications later."

# game/script.rpy:1247
translate english nama_pemain_c25b707f:

    # "Notifikasi: {b}Tagihan PayLater jatuh tempo besok.{/b}"
    "Notification: {b}PayLater bill due tomorrow.{/b}"

# game/script.rpy:1248
translate english nama_pemain_a6ba5703:

    # "Total tagihan saat ini: [t] (pokok beserta akumulasi bunga mingguan)."
    "Current total bill: [t] (principal plus accumulated weekly interest)."

# game/script.rpy:1256
translate english nama_pemain_f95d8d55:

    # "Lunas. Tapi uang jajanmu terkuras."
    "Paid in full. But your living allowance is completely drained."

# game/script.rpy:1261
translate english nama_pemain_a046041c:

    # "Lunas, tapi dana daruratmu terpakai untuk menutup keinginan bulan lalu."
    "Paid in full, but your emergency savings had to be sacrificed to cover last month's impulse spending."

# game/script.rpy:1266
translate english nama_pemain_731142db:

    # "Sisa tagihan terbawa ke bulan depan, dan bunga mingguan akan terus bertambah."
    "The remaining balance rolls over into next month, and weekly interest will continue to compound."

# game/script.rpy:1270
translate english nama_pemain_2fc30b51:

    # "Kamu tidak mampu membayar tagihan sama sekali. Tagihan PayLater menunggak dan bunga denda akan membengkak ke bulan depan."
    "You cannot afford to pay the bill at all. The PayLater account falls delinquent, and penalty interest will balloon into next month."

# game/script.rpy:1273
translate english nama_pemain_b14ca9ba:

    # tip "Utang konsumtif menggerus uang saku bulan berikutnya. Bayar lunas tepat waktu, atau lebih baik jangan berutang untuk keinginan."
    tip "Consumer debt eats away at next month's allowance. Pay it off on time, or better yet, never borrow for fleeting desires."

# game/script.rpy:1286
translate english nama_pemain_77e01c40:

    # "Hari terakhir bulan ini. Malam yang tenang. Kamu membuka aplikasi bank dan menatap angkanya."
    "The final day of the month. A quiet evening. You open your mobile banking app and gaze at the final figures."

# game/script.rpy:1310
translate english ending_bendahara_65e4548f:

    # "{b}ENDING A: Bendahara Handal{/b}"
    "{b}ENDING A: Master Treasurer{/b}"

# game/script.rpy:1311
translate english ending_bendahara_31345156:

    # "Uang jajanmu masih ada, dana darurat terjaga, dan tidak ada utang. Kamu bahkan masih bisa traktir Axel dan Michelle."
    "Your allowance still has a surplus, emergency savings remain intact, and you're completely debt-free. You can even comfortably treat Axel and Michelle."

# game/script.rpy:1317
translate english ending_bendahara_337afcf7:

    # sinta "Hebat, [nama]! Kamu sudah jadi bendahara untuk dirimu sendiri."
    sinta "Incredible, [nama]! You've become your own master treasurer."

# game/script.rpy:1321
translate english ending_bendahara_3450e730:

    # mama "Mama bangga. Bulan depan Mama tetap kirim ya, tapi kamu sekarang sudah paham caranya."
    mama "Mom is so proud of you. I'll still send your allowance next month, but now you truly know how to handle it."

# game/script.rpy:1334
translate english ending_selamat_cf431eb4:

    # "{b}ENDING B: Selamat Sampai Akhir Bulan{/b}"
    "{b}ENDING B: Safe Survivor{/b}"

# game/script.rpy:1337
translate english ending_selamat_9c089bfe:

    # "Kamu berhasil melewati bulan ini tanpa utang. Tidak sempurna, tapi tidak ada krisis."
    "You made it through the month completely free of debt. Not flawless, but crisis-free."

# game/script.rpy:1338
translate english ending_selamat_24222062:

    # "Masih ada beberapa keputusan yang bisa lebih baik: dana darurat yang lebih tebal, atau keinginan yang lebih terkendali."
    "There were a few choices that could have been better: a thicker emergency cushion, or more disciplined spending on wants."

# game/script.rpy:1349
translate english ending_paylater_630acad1:

    # "{b}ENDING C: Terjerat PayLater{/b}"
    "{b}ENDING C: PayLater Trap{/b}"

# game/script.rpy:1352
translate english ending_paylater_1dbf67f8:

    # "Uang jajanmu masih ada, tapi utang PayLater ikut terbawa ke bulan depan beserta biayanya."
    "You still have pocket money left, but PayLater debts roll over into next month alongside heavy interest."

# game/script.rpy:1353
translate english ending_paylater_8caaf9cb:

    # "Bulan depan akan terasa lebih berat dari yang kamu kira. Sebagian uang saku langsung terpotong untuk membayar tagihan lama."
    "Next month will feel much harder than you imagined. A chunk of your incoming allowance is already spoken for to pay off old bills."

# game/script.rpy:1364
translate english ending_habis_599fe740:

    # "{b}ENDING D: Mie Instan Akhir Bulan{/b}"
    "{b}ENDING D: Instant Noodle Crisis{/b}"

# game/script.rpy:1367
translate english ending_habis_df55b2ad:

    # "Saldomu habis dan masih ada beberapa hari tersisa. Kamu terpaksa makan mie instan dan meminjam uang ke teman."
    "Your balance hit zero with days still left on the calendar. You're forced to survive on instant noodles and ask friends for emergency cash."

# game/script.rpy:1369
translate english ending_habis_e0c93cb2:

    # mama "Nak, kok sudah kehabisan lagi? Ayo kita bicara dan susun rencana bersama."
    mama "Oh dear, running empty again? Come, let's talk and build a sensible plan together."

# game/script.rpy:1373
translate english ending_habis_f08a78e3:

    # "Ini bukan akhir dunia. Kesalahan pengelolaan uang adalah pelajaran, dan kamu bisa mencoba lagi bulan depan dengan strategi yang lebih baik."
    "This isn't the end of the world. Budgeting mistakes are valuable lessons, and you can try again next month with a stronger strategy."

# game/script.rpy:1404
translate english akhir_minggu_5974ef30:

    # "Akhir minggu ke-[minggu]. Kebutuhan pokok (makan dasar, transport, kuota, laundry) memakai {b}Rp 250.000{/b}."
    "End of week [minggu]. Basic living essentials (meals, transport, data, laundry) cost {b}Rp 250,000{/b}."

# game/script.rpy:1411
translate english akhir_minggu_493e35c8:

    # "{b}Rekap minggu ke-[minggu]{/b}\nPengeluaran: [t_keluar]. Sisa uang jajan: [t_uang]. Dana darurat: [t_dana]."
    "{b}Week [minggu] Summary{/b}\nExpenses: [t_keluar]. Remaining allowance: [t_uang]. Emergency fund: [t_dana]."

# game/script.rpy:1418
translate english akhir_minggu_002745b7:

    # "Tagihan PayLater dikenakan bunga mingguan 5 persen (+[t_bunga]). Total tagihan berjalan: {b}[t_hutang]{/b}."
    "PayLater balance incurs a 5 percent weekly interest charge (+[t_bunga]). Total active debt: {b}[t_hutang]{/b}."

# game/script.rpy:1419
translate english akhir_minggu_632ed22a:

    # tip "Bunga PayLater terus bertambah setiap minggu selama belum lunas. Semakin lama menunda, semakin berat beban finansialmu."
    tip "PayLater interest continues to accumulate weekly until fully paid off. The longer you delay, the heavier your financial burden becomes."

